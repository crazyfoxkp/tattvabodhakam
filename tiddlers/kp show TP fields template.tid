title: kp show TP fields template

\whitespace trim
<% if [all[current]tag[TP]] %>
<table class="showfields">
  <$list filter="[<currentTiddler>fields[]] -title -tags -text -created -modified -creator -modifier" variable="fieldname">
    <$list filter="[<currentTiddler>get<fieldname>]" variable="field-value">
      <tr>
        <td class="dots"><$text text=<<fieldname>> /></td>
        <td class="data">
          <$transclude field=<<fieldname>> mode="block" />
        </td>
      </tr>
    </$list>
  </$list>
</table>
<% endif %>