/* use for displaying field values within view templates ; used in show-kpfields-template */

.showfields {
   --bk85: #080e08;
   --bk76: #191a0f;
   font-size: 18px;
}
.showfields .dots { 
   padding-right: 15px;
   padding-left: 10px;
   margin: 0;
   border-bottom: 1px dotted gray;
   color: #d2dd7d;
   width: 5%;
   font-size: 24px;
   line-height: 1.4;
   text-align: right;
   vertical-align: top;
   padding-top: 10px;
}
.showfields .data { 
   font-size: 18px;
   padding: 10px;
   line-height: 1.5;
   text-align: left;
   color: #bfbfc2;
   vertical-align: top;
}

/* Reset margins on block elements inside the table cell */
.showfields .data p,
.showfields .data h1,
.showfields .data h2,
.showfields .data h3,
.showfields .data h4 {
   margin-top: 0.4em;
   margin-bottom: 0.4em;
}

.showfields .data p:first-child,
.showfields .data h1:first-child,
.showfields .data h2:first-child,
.showfields .data h3:first-child {
   margin-top: 0;
}

.showfields .data ul,
.showfields .data ol {
   margin-top: 0.4em;
   margin-bottom: 0.4em;
   padding-left: 1.5em;
}
.showfields tr:nth-child(even) {
   background: var(--bk85); 
}
.showfields tr:nth-child(odd) {
   background: var(--bk76); 
}




