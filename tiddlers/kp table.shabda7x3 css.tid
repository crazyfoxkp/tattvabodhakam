title: kp table.shabda7x3 css

 \rules except dash
.shabda7x3 { 
  /* CSS HEX --bk-colored: --light-cyan: #d6fbffff; --muted-headers: --chinese-violet: #766c7fff; --melon: --melon: #fcb5b5ff; --text-color: --black: #000000ff; --tab-border: --blue-munsell: #448fa3ff; --bk-light: --white: #ffffff; */ --bk-colored: #d6fbffff;
  --muted-headers: #766c7fff;
  --melon: #fcb5b5ff;
  --text-color: #000;
  --tab-border: #fcb5b5ff; /* blue munsell #448fa3ff; */
  --bk-light: #ffffff; 
  width: 80%; /* Table takes up 50% of the viewport */ 
  border: 1px solid var(--tab-border); 
  padding: 10px; /* table-layout: fixed; /* Fixed layout to enforce column widths */ 
  }
.shabda7x3   tr:nth-child(odd) { background-color: var(--bk-colored); }
.shabda7x3   tr:nth-child(even) { background-color: var(--bk-light); }
.shabda7x3   th:first-child, .shabda7x3 td:first-child { width: 10%; /* Fix the first column width to 15% */ 
  color: var(--muted-headers); 
  white-space: nowrap; /* Prevent content from expanding the column */ 
  overflow: hidden; /* Hide overflow content */ 
  text-overflow: ellipsis; /* Show ellipsis if content overflows */ } 
.shabda7x3 th { width: auto; /* Allow remaining columns to adjust automatically */ color: var(--muted-headers); }
.shabda7x3  th:nth-child(6), .shabda7x3 td:nth-child(6) { width: 10%; /* Set a fixed width for the 6th column */ 
  background-color: var(--bk-light); } 
.shabda7x3 td { padding-left: 20px; }
.shabda7x3 tr td:nth-child(5) { background: var(--bk-light); }
.shabda7x3 td:empty { background-color: var(--bk-light); }
.shabda7x3 tr:last-child td { color: var(--text-color); 
  border-bottom: 2px solid var(--tab-border); /* Add bottom border to the last row */ }

