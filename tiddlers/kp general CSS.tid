text-decoration-color: pink;
background-color: black;
            font-weight: 500;
        }


/* fill empty wikitable cells with this color #252716 */
.table td:empty {background:#252716;
}

/* Target standard TiddlyWiki table cells */
.tc-tiddler-body table th:empty,
.tc-tiddler-body table td:empty {
    /* For truly empty cells */
    background: #252716;
}

/* 🎯 Crucial fix: Target cells that contain only whitespace or zero-width spaces. 
   TiddlyWiki often renders 'empty' Markdown cells with a non-breaking space (&nbsp;). 
   This rule prevents the cell from collapsing and sets the color. */
.tc-tiddler-body table td:after {
    content: "\a0"; /* Non-breaking space, ensures the cell has height/width */
    visibility: hidden; /* Keep the content invisible */
}