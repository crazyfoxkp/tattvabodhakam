                @@.donotprint {{$:/images/icon-park/base/preview-open-outline}}@@
        </$button>
        <$button class="tc-btn-invisible" message="tm-edit-tiddler" param=<<currentTiddler>> tooltip={{{ [[Create / Edit ]] }}}>
                @@.donotprint {{$:/core/images/edit-button}}@@
