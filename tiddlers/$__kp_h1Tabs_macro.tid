title: $:/kp/h1Tabs/macro

\define renderedSection()
\whitespace trim
<!-- Extract the text belonging to the active tab -->
<$let 
  pattern={{{ [[(?m)^!\s*]addsuffix<activeTab>addsuffix[(\r?\n[\s\S]*?)(?=(^!\s*|\z))]] }}}
  rawSection={{{ [{!!text}search-replace:gim:regexp<pattern>,[$1]] }}}
>
<!-- Read state from the toolbar toggle button -->
<$let chipSection={{{ [[$:/state/kp-showHideBracketContents/view]text[show]then<rawSection>search-replace:gim:regexp<findBracketsPattern>,<showBracketsPattern>] :else[<rawSection>search-replace:gim:regexp<findBracketsPattern>,<wordChipTooltipPattern>] }}}>
  <$transclude $variable="chipSection" $mode="block"/>
</$let>
</$let>
\end