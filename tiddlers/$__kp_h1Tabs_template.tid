\whitespace trim

<div style="background: #1e1e1e; color: #00ffc8; padding: 12px; border: 2px solid #00ffc8; font-family: monospace; border-radius: 4px; margin-bottom: 16px;">
  <div style="font-weight: bold; border-bottom: 1px solid #00ffc8; padding-bottom: 4px; margin-bottom: 8px;">
    [KP DIAGNOSTIC MODULE - STEP 6]
  </div>
  
  <strong>1. Raw Tiddler Title:</strong> <<currentTiddler>><br/>

  <strong>2. Plain Splitting Test:</strong> 
  <code>{{{ [{!!text}splitregexp[\n]first[5]join[ /// ]] }}}</code><br/>

  <strong>3. Prefix Extraction:</strong> 
  <$let rawLines={{{ [{!!text}splitregexp[\n]] }}}>
    <code><$list filter="[enlist<rawLines>prefix[!]]"><$text text=<<currentTiddler>>/> | </$list></code>
  </$let><br/>

  <strong>4. Trimmed Heading Extraction:</strong>
  <$let rawLines={{{ [{!!text}splitregexp[\n]] }}}>
    <code><$list filter="[enlist<rawLines>prefix[!]]" variable="line"><$text text={{{ [<line>removeprefix[!]trim[]] }}}/> | </$list></code>
  </$let>
</div>

<%if [<currentTiddler>is[system]]%>
  <$transclude $field="text" $mode="block"/>
<%else%>
  <$transclude $field="text" $mode="block"/>
<%endif%>