\whitespace trim

\define h1OnlyPattern() ^![^!].*$

\define renderSectionContent()
\whitespace trim
<$let 
  stateTiddler={{{ [[$:/state/tab/h1-sections/]addsuffix<currentTiddler>] }}}
  defaultTab={{{ [{!!text}splitregexp[\n]trim[]regexp<h1OnlyPattern>] +[removeprefix[!]trim[]first[]] }}}
  activeTab={{{ [<stateTiddler>get[text]] :else[<defaultTab>] }}}
>
  <$list filter="[{!!text}splitregexp[\n]trim[]regexp<h1OnlyPattern>]" variable="h1Line">
    <$list filter="[<h1Line>removeprefix[!]trim[]match<activeTab>]" variable="matchedTab">
      <$let 
        headingWithSpace={{{ [[! ]addsuffix<activeTab>] }}}
        headingWithoutSpace={{{ [[!]addsuffix<activeTab>] }}}
        afterActiveH1={{{ [{!!text}split<headingWithSpace>last[]] :else[{!!text}split<headingWithoutSpace>last[]]} }}}
        extractedSection={{{ [<afterActiveH1>splitregexp[\n\!]first[]] }}}
        chipSection={{{ [[$:/state/kp-showHideBracketContents/view]text[show]then<extractedSection>search-replace:gim:regexp<findBracketsPattern>,<showBracketsPattern>] :else[<extractedSection>search-replace:gim:regexp<findBracketsPattern>,<wordChipTooltipPattern>] }}}
      >
        <$transclude $variable="chipSection" $mode="block"/>
      </$let>
    </$list>
  </$list>
</$let>
\end

\define renderFullTextContent()
\whitespace trim
<$let fullText={{{ [[$:/state/kp-showHideBracketContents/view]text[show]then<currentTiddler>get[text]search-replace:gim:regexp<findBracketsPattern>,<showBracketsPattern>] :else[{!!text}search-replace:gim:regexp<findBracketsPattern>,<wordChipTooltipPattern>] }}}>
  <$transclude $variable="fullText" $mode="block"/>
</$let>
\end

<%if [<currentTiddler>is[system]]%>
  <$transclude $field="text" $mode="block"/>
<%else%>

  <$list filter="[{!!text}splitregexp[\n]trim[]regexp<h1OnlyPattern>] +[removeprefix[!]trim[]first[]]" variable="hasHeadings">
    <div class="tc-tab-set tc-sidebar-header">
      <div class="tc-tab-buttons">
        <$list filter="[{!!text}splitregexp[\n]trim[]regexp<h1OnlyPattern>] +[removeprefix[!]trim[]]" variable="headingTitle">
          <$let stateTiddler={{{ [[$:/state/tab/h1-sections/]addsuffix<currentTiddler>] }}}>
            <$button set=<<stateTiddler>> setTo=<<headingTitle>> selectedClass="tc-tab-selected">
              <$text text=<<headingTitle>>/>
            </$button>
          </$let>
        </$list>
      </div>

      <div class="tc-tab-content" style="margin-top: 10px;">
        <<renderSectionContent>>
      </div>
    </div>
  </$list>

  <$list filter="[{!!text}splitregexp[\n]trim[]regexp<h1OnlyPattern>] +[removeprefix[!]trim[]count[]match[0]]" variable="noHeadings">
    <<renderFullTextContent>>
  </$list>

<%endif%>