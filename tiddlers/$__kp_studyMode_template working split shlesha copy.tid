\define get-shloka-viewer-html(title, text, pada1, anvaya1, artha1, vyakarana1, tatparya1, pada2, anvaya2, artha2, vyakarana2, tatparya2, pada3, anvaya3, artha3, vyakarana3, tatparya3)
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    :root {
      --bg-color: #0d0f00;
      --card-bg: #252716;
      --text-color: #c6c6c6;
      --primary-color: #86b03b;
      --accent-color: #859900;
      --border-color: #4c4c4c;
      --chip-bg: #303222;
      --chip-hover: #3f4900;
      --highlight-color: #ff8b69;
      --sandhi-line-color: #b58900;
      --muted-gray: #ababab;
      --sidebar-bg: #1b1b20;
    }
    body {
      font-family: 'Georgia', 'Noto Sans Devanagari', 'Noto Sans Kannada', serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      margin: 0;
      padding: 0;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }
    .main-content {
      flex: 1;
      padding: .1rem;
      overflow-y: auto;
    }
    .verse-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.4);
    }
    .verse-header {
      padding: 1.2rem;
      font-size: 22px;
      line-height: 1.8;
      text-align: left;
      /*font-weight: 600; */
      color: #c6c6c6;
      background-color: #252716;
      border-radius: 8px 8px 0 0;
      border-bottom: 1px dashed var(--border-color);
    }
    .verse-details {
      /*padding: .1rem; */
      background-color: var(--card-bg);
    }
    .dots {
      /*border-bottom: 1px dotted var(--accent-color); */
      display: inline-block;
      padding-bottom: 2px;
    }
    
    /* Top-level Shlesha Disclosures */
    details.shlesha-block {
      margin-bottom: 1.2rem;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--bg-color);
    }
    details.shlesha-block > summary {
      padding: 0.8rem 1.2rem;
      font-size: 1.2rem;
      /*font-weight: bold; */
      color: #d2dd7d;
      cursor: pointer;
      user-select: none;
      background-color: #171a06;
      border-radius: 6px;
    }
    details.shlesha-block[open] > summary {
      border-bottom: 1px solid var(--border-color);
      border-radius: 6px 6px 0 0;
    }
    .shlesha-content {
      padding: 1rem;
    }

    /* Nested Inner Disclosures */
    details.disclosure-block {
      margin-top: 0.8rem;
      border-radius: 4px;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
    }
    details.disclosure-block:first-child {
      margin-top: 0;
    }
    details.disclosure-block summary {
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      /*font-weight: bold; */
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #d2dd7d;
      cursor: pointer;
      user-select: none;
      outline: none;
    }
    details.disclosure-block[open] summary {
      border-bottom: 1px solid var(--border-color);
    }
    .disclosure-content {
      padding: 0.9rem;
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--text-color);
      /*white-space: pre-wrap; */
    }

    /* Padaccheda Formatting */
    .padaccheda-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.8rem;
      row-gap: 1.8rem;
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .padaccheda-line-break {
      flex-basis: 100%;
      height: 0;
      margin: 0;
    }
    .danda-mark {
      font-size: 1.2rem;
      /*font-weight: bold; */
      color: var(--text-color);
      padding: 0 0 0 0.2rem;
      user-select: none;
      align-self: center;
    }
    .sandhi-pair-container {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .word-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
      width: auto;
      flex-shrink: 0;
    }
    .word-chip {
      background-color: var(--chip-bg);
      color: var(--text-color);
      padding: 0.2rem 0.5rem;
      height: 32px;
      width: auto;
      max-width: max-content;
      flex-shrink: 0;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
      box-sizing: border-box;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }
    .word-chip:hover, .word-chip.active {
      background-color: var(--chip-hover);
      border-color: var(--accent-color);
      color: #ffffff;
    }
    .sandhi-bridge {
      position: absolute;
      top: -14px;
      left: 50%;
      width: calc(100% + 0.8rem);
      height: 12px;
      border-top: 2px solid var(--sandhi-line-color);
      border-left: 2px solid var(--sandhi-line-color);
      border-right: 2px solid var(--sandhi-line-color);
      border-radius: 4px 4px 0 0;
      cursor: pointer;
      z-index: 2;
    }
    .sandhi-node {
      position: absolute;
      top: -8px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--bg-color);
      color: var(--highlight-color);
      border: 1.5px solid var(--sandhi-line-color);
      border-radius: 50%;
      width: 15px;
      height: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.6rem;
    }
    .sandhi-bridge:hover .sandhi-node, .sandhi-bridge.active .sandhi-node {
      background-color: var(--sandhi-line-color);
      color: #ffffff;
      transform: translateX(-50%) scale(1.2);
    }

    /* Sidebar */
    .sidebar {
      width: 560px;
      background: var(--sidebar-bg);
      border-left: 1px solid var(--border-color);
      box-shadow: -2px 0 8px rgba(0,0,0,0.5);
      transform: translateX(100%);
      transition: transform 0.3s ease-in-out;
      display: flex;
      flex-direction: column;
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-header {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: var(--card-bg);
    }
    .sidebar-title { color: var(--primary-color); }
    .close-btn { background: none; border: none; font-size: 1.2rem; color: var(--text-color); cursor: pointer; }
    .sidebar-body { padding: 1.2rem; overflow-y: auto; flex: 1; font-size: 0.95rem; line-height: 1.6; }
    .word-meaning-subtext {
      color: var(--highlight-color);
      font-size: 1.05rem;
      margin-top: -0.2rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    .meaning-line { margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px dashed var(--border-color); }
    .meaning-line:last-child { border-bottom: none; }
    .sandhi-block {
      background: var(--chip-bg);
      border-left: 3px solid var(--sandhi-line-color);
      padding: 0.6rem 0.8rem;
      margin-top: 0.5rem;
      border-radius: 0 4px 4px 0;
      color: var(--text-color);
    }
  </style>
</head>
<body>
  <main class="main-content">
    <div id="shloka-container"></div>
  </main>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <span class="sidebar-title" id="sidebar-title"><span class="dots">व्याकरणविशेषः</span></span>
      <button class="close-btn" onclick="closeSidebar()">&times;</button>
    </div>
    <div class="sidebar-body" id="sidebar-body">
      <p style="color: var(--muted-gray);">Click on any word in Padaccheda to view detailed analysis.</p>
    </div>
  </aside>

  <script>
    function safeDecode(str) {
      try { return decodeURIComponent(str || ''); } catch(e) { return str || ''; }
    }

    const currentItem = {
      title: safeDecode(`$title$`),
      text: safeDecode(`$text$`),
      sets: [
        {
          id: 1,
          label: 'श्लेषः १',
          pada: safeDecode(`$pada1$`),
          anvaya: safeDecode(`$anvaya1$`),
          artha: safeDecode(`$artha1$`),
          vyakarana: safeDecode(`$vyakarana1$`),
          tatparya: safeDecode(`$tatparya1$`)
        },
        {
          id: 2,
          label: 'श्लेषः २',
          pada: safeDecode(`$pada2$`),
          anvaya: safeDecode(`$anvaya2$`),
          artha: safeDecode(`$artha2$`),
          vyakarana: safeDecode(`$vyakarana2$`),
          tatparya: safeDecode(`$tatparya2$`)
        },
        {
          id: 3,
          label: 'श्लेषः ३',
          pada: safeDecode(`$pada3$`),
          anvaya: safeDecode(`$anvaya3$`),
          artha: safeDecode(`$artha3$`),
          vyakarana: safeDecode(`$vyakarana3$`),
          tatparya: safeDecode(`$tatparya3$`)
        }
      ].filter(s => s.pada || s.anvaya || s.artha || s.vyakarana || s.tatparya)
    };

    function parsePadaccheda(rawHtml) {
      if (!rawHtml) return [];
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = rawHtml;
      const elements = tempDiv.querySelectorAll('span, wrd');
      const tokens = [];

      if (elements.length > 0) {
        elements.forEach(el => {
          const cleanText = el.textContent.replace(/,,\d+(,\d+)*,,/g, '').trim();
          if (cleanText) tokens.push(cleanText);
        });
      } else {
        const cleanText = tempDiv.textContent.replace(/,,\d+(,\d+)*,,/g, '').trim();
        cleanText.split(/\s+/).forEach(t => { if(t) tokens.push(t); });
      }
      return tokens;
    }

    function cleanWord(str) {
      return (str || '').replace(/[^a-zA-Z0-9\u0900-\u097F\u0C80-\u0CFF]/g, '').trim();
    }

    function findBreakIndex(shlokaText, padacchedaWords) {
      if (!shlokaText || !padacchedaWords || !padacchedaWords.length) return -1;

      const parts = shlokaText.split('।');
      if (parts.length <= 1) return -1;

      const line2Words = parts[1].replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(w => w.length > 0);
      if (!line2Words.length) return -1;

      const targetWord = cleanWord(line2Words[0]);
      if (!targetWord) return -1;

      for (let idx = 0; idx < padacchedaWords.length; idx++) {
        const padWord = cleanWord(padacchedaWords[idx]);
        if (padWord && (padWord.includes(targetWord) || targetWord.includes(padWord))) {
          return idx;
        }
      }
      return -1;
    }

    function parseMeaningString(meaningString) {
      const meaningMap = {};
      if (!meaningString) return meaningMap;
      const regex = /⟣\s*([^=]+)=\s*(.+)/g;
      let match;
      while ((match = regex.exec(meaningString)) !== null) {
        meaningMap[match[1].trim()] = match[2].trim();
      }
      return meaningMap;
    }

    function buildSequentialArthaSentence(meaningString) {
      if (!meaningString) return '';
      const meaningsList = [];
      const regex = /⟣\s*([^=]+)=\s*(.+)/g;
      let match;
      while ((match = regex.exec(meaningString)) !== null) {
        const meaning = match[2].trim();
        if (meaning) meaningsList.push(meaning);
      }
      return meaningsList.join(' ');
    }

    function parseGrammarAndSandhi(grammarString) {
      const grammarMap = {};
      const sandhiMap = {};
      if (!grammarString) return { grammarMap, sandhiMap };

      const regex = /⬩\s*''([^'']+)''\s*=\s*([\s\S]*?)(?=(⬩\s*''|$))/g;
      let match;

      while ((match = regex.exec(grammarString)) !== null) {
        const wordKey = match[1].trim();
        let fullText = match[2].trim();
        const sandhiIndex = fullText.search(/\n\s*\}/);

        if (sandhiIndex !== -1) {
          grammarMap[wordKey] = fullText.substring(0, sandhiIndex).trim();
          sandhiMap[wordKey] = fullText.substring(sandhiIndex).replace(/\n\s*\}/, '').trim();
        } else {
          grammarMap[wordKey] = fullText;
        }
      }
      return { grammarMap, sandhiMap };
    }

    function renderPadacchedaHtml(setObj) {
      const padacchedaWords = parsePadaccheda(setObj.pada);
      const { sandhiMap } = parseGrammarAndSandhi(setObj.vyakarana);
      const breakIndex = findBreakIndex(currentItem.text, padacchedaWords);

      let padacchedaHtml = '';
      let i = 0;

      while (i < padacchedaWords.length) {
        if (i === breakIndex && breakIndex > 0) {
          padacchedaHtml += `<span class="danda-mark">।</span><div class="padaccheda-line-break"></div>`;
        }

        const word = padacchedaWords[i];
        const hasSandhiWithNext = (sandhiMap[word] && i < padacchedaWords.length - 1);

        if (hasSandhiWithNext) {
          let chainHtml = '';
          while (i < padacchedaWords.length) {
            if (i === breakIndex && breakIndex > 0 && chainHtml !== '') break;

            const currentWord = padacchedaWords[i];
            const hasBridge = (sandhiMap[currentWord] && i < padacchedaWords.length - 1);
            const nextWord = padacchedaWords[i + 1] || '';

            chainHtml += `
              <div class="word-wrapper">
                <span class="word-chip" onclick="showWordGrammar(${setObj.id}, '${currentWord}', event)">
                  ${currentWord}
                </span>
                ${hasBridge ? `
                  <div class="sandhi-bridge" title="Sandhi Detail" onclick="showSandhiDetails(${setObj.id}, '${currentWord}', '${nextWord}', event)">
                    <div class="sandhi-node">⚡</div>
                  </div>
                ` : ''}
              </div>
            `;
            i++;
            if (!hasBridge) break;
          }
          padacchedaHtml += `<div class="sandhi-pair-container">${chainHtml}</div>`;
        } else {
          padacchedaHtml += `
            <div class="word-wrapper">
              <span class="word-chip" onclick="showWordGrammar(${setObj.id}, '${word}', event)">
                ${word}
              </span>
            </div>
          `;
          i++;
        }
      }

      if (padacchedaHtml) {
        padacchedaHtml += `<span class="danda-mark">॥</span>`;
      }

      return padacchedaHtml;
    }

    function renderSetContent(setObj) {
      const padacchedaHtml = renderPadacchedaHtml(setObj);
      const fullMeaningSentence = buildSequentialArthaSentence(setObj.artha);

      return `
        ${padacchedaHtml ? `
          <details class="disclosure-block" open>
            <summary><span class="dots">पदच्छेदः</span></summary>
            <div class="disclosure-content">
              <div class="padaccheda-list">${padacchedaHtml}</div>
            </div>
          </details>
        ` : ''}
        
        ${setObj.anvaya ? `
          <details class="disclosure-block">
            <summary><span class="dots">अन्वयः</span></summary>
            <div class="disclosure-content">${setObj.anvaya}</div>
          </details>
        ` : ''}

        ${fullMeaningSentence ? `
          <details class="disclosure-block">
            <summary><span class="dots">अर्थः (ಸಾರಾಂಶಃ)</span></summary>
            <div class="disclosure-content">${fullMeaningSentence}</div>
          </details>
        ` : ''}

        ${setObj.tatparya ? `
          <details class="disclosure-block">
            <summary><span class="dots">तात्पर्यम्</span></summary>
            <div class="disclosure-content">${setObj.tatparya}</div>
          </details>
        ` : ''}
      `;
    }

    function renderViewer() {
      const container = document.getElementById('shloka-container');
      let setsHtml = '';

      currentItem.sets.forEach((setObj, index) => {
        const isOpen = index === 0 ? 'open' : '';
        setsHtml += `
          <details class="shlesha-block" ${isOpen}>
            <summary><span class="dots">${setObj.label}</span></summary>
            <div class="shlesha-content">
              ${renderSetContent(setObj)}
            </div>
          </details>
        `;
      });

      container.innerHTML = `
        <div class="verse-card">
          <div class="verse-header">
            <div>${currentItem.text || currentItem.title}</div>
          </div>
          <div class="verse-details">
            ${setsHtml}
          </div>
        </div>
      `;
    }

    function showWordGrammar(setId, word, event) {
      event.stopPropagation();
      const setObj = currentItem.sets.find(s => s.id === setId);
      if (!setObj) return;

      const { grammarMap, sandhiMap } = parseGrammarAndSandhi(setObj.vyakarana);
      const wordMeaningMap = parseMeaningString(setObj.artha);
      
      const sidebar = document.getElementById('sidebar');
      const sidebarBody = document.getElementById('sidebar-body');

      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
      event.currentTarget.classList.add('active');

      const rawText = grammarMap[word] || 'No grammar details available for this word.';
      const kannadaMeaning = wordMeaningMap[word] || '';

      const formattedGrammar = rawText
        .split('\n')
        .map(line => `<div class="meaning-line">${line.trim()}</div>`)
        .join('');

      let sandhiHtml = '';
      if (sandhiMap[word]) {
        sandhiHtml = `<div class="sandhi-block"><strong>सन्धि-नियमः:</strong> ${sandhiMap[word]}</div>`;
      }

      document.getElementById('sidebar-title').innerHTML = '<span class="dots">व्याकरणविशेषः (' + setObj.label + ')</span>';
      sidebarBody.innerHTML = `
        <h2 style="margin-top:0; margin-bottom: 0.5rem; color: var(--primary-color);">${word}</h2>
        ${kannadaMeaning ? `<div class="word-meaning-subtext">${kannadaMeaning}</div>` : ''}
        <div>${formattedGrammar}</div>
        ${sandhiHtml}
      `;

      sidebar.classList.add('open');
    }

    function showSandhiDetails(setId, word, nextWord, event) {
      event.stopPropagation();
      const setObj = currentItem.sets.find(s => s.id === setId);
      if (!setObj) return;

      const { sandhiMap } = parseGrammarAndSandhi(setObj.vyakarana);
      const sidebar = document.getElementById('sidebar');
      const sidebarBody = document.getElementById('sidebar-body');

      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
      event.currentTarget.classList.add('active');

      const sandhiPairTitle = nextWord ? `${word} + ${nextWord}` : word;

      document.getElementById('sidebar-title').innerHTML = '<span class="dots">सन्धि-नियमः (' + setObj.label + ')</span>';
      sidebarBody.innerHTML = `
        <h2 style="margin-top:0; color: var(--primary-color);">सन्धिः (${sandhiPairTitle})</h2>
        <div class="sandhi-block">${sandhiMap[word]}</div>
      `;

      sidebar.classList.add('open');
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
    }

    renderViewer();
  </script>
</body>
</html>
\end

