title: kp show SKS-SMV fields

<%if [all[current]tag[SKS-SMV]] %>
    <$let sortlist={{SKS-SMV_view_fieldOrderList!!list}} targetTiddler=<<currentTiddler>>>
        <table class = "showfields"> 
            <$list filter="[enlist<sortlist>] :filter[<targetTiddler>has<currentTiddler>]" variable="fieldname">
                <$list filter="[<currentTiddler>get<fieldname>]" variable=field-value>
                    <tr>      
                        <td class=dots>
                            <%if [<fieldname>match[तात्पर्यम्]]%>
                                ತಾತ್ಪರ್ಯ
                            <%elseif [<fieldname>match[पादटिप्पणी]]%>
                                पादटिप्पणी
                            <%elseif [<fieldname>search::regexp[kp_*]] %>
                                <$text text={{{ [<fieldname>removeprefix[kp_]] }}} />
                            <%endif%>
                        </td>
                        <td class=data>
                        <$list filter="[<fieldname>match[kp_व्याकर्ण_विशेषः]] :then[<field-value>search-replace:gim:regexp[\n⬩],[<br/>⬩]search-replace:gim:regexp[\n],[<br/>⋯ ]search-replace:gim:regexp[<br/>⋯ }],[<br/>}]]  " variable=field_contents><<field_contents>></$list> 
                        <$list filter="[<fieldname>match[kp_अर्थः]] :then[<field-value>search-replace:gim:regexp[\n⟣],[<br/>⟣]]  " variable=field_contents2>       
                            <$list filter="[<fieldname>match[kp_अर्थः]] :then[<field-value>search-replace:gim:regexp[^.*?=(.*)\n*],[$1,]search-replace:gim:regexp<squarebracketpattern>,[]] +[removesuffix[,]addsuffix[.]] +[search-replace:gim:regexp<viewTemplateDeDupCommas>,[, ]search-replace:gim:regexp[^\s*,\s*],[]]"  variable=sentence>
                                <% if [<sentence>search::regexp<viewTemplatePattern>] %>
                                    ---
                                <% else %>
                                    <<field_contents2>><br><br>
                                    <<sentence>><br>
                                <% endif %>               
                            </$list>
                        </$list>
                        <$list filter="[<fieldname>!search::regexp[kp_अर्थः|kp_व्याकर्ण_विशेषः]] :then[<field-value>]  " variable=sentence2><<sentence2>><br/></$list> 
                        </td>
                    </tr>
                </$list>
            </$list>
        </table>
    </$let>
<%endif%>