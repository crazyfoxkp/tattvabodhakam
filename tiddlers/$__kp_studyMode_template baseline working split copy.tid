\define get-shloka-viewer-html(title, text, pada, anvaya, artha, vyakarana, tatparya)
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    :root {
      --bg-color: #0d0f00;
      --card-bg: #252716;
      --text-color: #c6c6c6;
      --primary-color: #86b03b;
      --accent-color: #859900;
      --border-color: #4c4c4c;
      --chip-bg: #303222;
      --chip-hover: #3f4900;
      --highlight-color: #ff8b69;
      --sandhi-line-color: #b58900;
      --muted-gray: #ababab;
      --sidebar-bg: #1b1b20;
    }
    body {
      font-family: 'Georgia', 'Noto Sans Devanagari', 'Noto Sans Kannada', serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      margin: 0;
      padding: 0;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }
    .main-content {
      flex: 1;
      padding: 1.5rem;
      overflow-y: auto;
    }
    .verse-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.4);
    }
    .verse-header {
      padding: 1.2rem;
      font-size: 1.3rem;
      line-height: 1.8;
      text-align: center;
      font-weight: 600;
      color: var(--primary-color);
      border-bottom: 1px dashed var(--border-color);
    }
    .verse-details {
      padding: 1.5rem;
      background-color: var(--card-bg);
    }
    .section-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-color);
      margin-top: 1.2rem;
      margin-bottom: 0.75rem;
      font-weight: bold;
    }
    .section-title:first-child { margin-top: 0; }
    .padaccheda-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.8rem;
      row-gap: 2.2rem;
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .padaccheda-line-break {
      flex-basis: 100%;
      height: 0;
      margin: 0;
    }
    .danda-mark {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--accent-color);
      padding: 0 0.2rem;
      user-select: none;
    }
    .sandhi-pair-container {
      display: inline-flex;
      align-items: flex-end;
      gap: 0.8rem;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .word-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
    }
    .word-chip {
      background-color: var(--chip-bg);
      color: var(--text-color);
      padding: 0.4rem 0.8rem;
      border-radius: 4px;
      font-size: 1.1rem;
      cursor: pointer;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }
    .word-chip:hover, .word-chip.active {
      background-color: var(--chip-hover);
      border-color: var(--accent-color);
      color: #ffffff;
    }
    .sandhi-bridge {
      position: absolute;
      top: -20px;
      left: 50%;
      width: calc(100% + 0.8rem);
      height: 16px;
      border-top: 2px solid var(--sandhi-line-color);
      border-left: 2px solid var(--sandhi-line-color);
      border-right: 2px solid var(--sandhi-line-color);
      border-radius: 4px 4px 0 0;
      cursor: pointer;
      z-index: 2;
    }
    .sandhi-node {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--bg-color);
      color: var(--highlight-color);
      border: 1.5px solid var(--sandhi-line-color);
      border-radius: 50%;
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
    }
    .sandhi-bridge:hover .sandhi-node, .sandhi-bridge.active .sandhi-node {
      background-color: var(--sandhi-line-color);
      color: #ffffff;
      transform: translateX(-50%) scale(1.25);
    }
    details.disclosure-block {
      margin-top: 1rem;
      border-radius: 4px;
      background: var(--bg-color);
      border: 1px solid var(--border-color);
    }
    details.disclosure-block summary {
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent-color);
      cursor: pointer;
      user-select: none;
      outline: none;
    }
    details.disclosure-block[open] summary {
      border-bottom: 1px solid var(--border-color);
    }
    .disclosure-content {
      padding: 1rem;
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--text-color);
      white-space: pre-wrap;
    }
    .sidebar {
      width: 360px;
      background: var(--sidebar-bg);
      border-left: 1px solid var(--border-color);
      box-shadow: -2px 0 8px rgba(0,0,0,0.5);
      transform: translateX(100%);
      transition: transform 0.3s ease-in-out;
      display: flex;
      flex-direction: column;
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-header {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: var(--card-bg);
    }
    .sidebar-title { font-weight: bold; color: var(--primary-color); }
    .close-btn { background: none; border: none; font-size: 1.2rem; color: var(--text-color); cursor: pointer; }
    .sidebar-body { padding: 1.2rem; overflow-y: auto; flex: 1; font-size: 0.95rem; line-height: 1.6; }
    .word-meaning-subtext {
      color: var(--highlight-color);
      font-size: 1.05rem;
      margin-top: -0.2rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    .meaning-line { margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px dashed var(--border-color); }
    .meaning-line:last-child { border-bottom: none; }
    .sandhi-block {
      background: var(--chip-bg);
      border-left: 3px solid var(--sandhi-line-color);
      padding: 0.6rem 0.8rem;
      margin-top: 0.5rem;
      border-radius: 0 4px 4px 0;
      color: var(--text-color);
    }
  </style>
</head>
<body>
  <main class="main-content">
    <div id="shloka-container"></div>
  </main>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <span class="sidebar-title" id="sidebar-title">व्याकरणविशेषः</span>
      <button class="close-btn" onclick="closeSidebar()">&times;</button>
    </div>
    <div class="sidebar-body" id="sidebar-body">
      <p style="color: var(--muted-gray);">Click on any word in Padaccheda to view detailed analysis.</p>
    </div>
  </aside>

  <script>
    function safeDecode(str) {
      try { return decodeURIComponent(str || ''); } catch(e) { return str || ''; }
    }

    const currentItem = {
      title: safeDecode(`$title$`),
      text: safeDecode(`$text$`),
      kp_पदच्छछेदः: safeDecode(`$pada$`),
      kp_अन्वयः: safeDecode(`$anvaya$`),
      kp_अर्थः: safeDecode(`$artha$`),
      kp_व्याकर्ण_विशेषः: safeDecode(`$vyakarana$`),
      kp_तात्पर्यम्: safeDecode(`$tatparya$`)
    };

    function parsePadaccheda(rawHtml) {
      if (!rawHtml) return [];
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = rawHtml;
      const elements = tempDiv.querySelectorAll('span, wrd');
      const tokens = [];

      if (elements.length > 0) {
        elements.forEach(el => {
          const cleanText = el.textContent.replace(/,,\d+(,\d+)*,,/g, '').trim();
          if (cleanText) tokens.push(cleanText);
        });
      } else {
        const cleanText = tempDiv.textContent.replace(/,,\d+(,\d+)*,,/g, '').trim();
        cleanText.split(/\s+/).forEach(t => { if(t) tokens.push(t); });
      }
      return tokens;
    }

    function cleanWord(str) {
      return (str || '').replace(/[^a-zA-Z0-9\u0900-\u097F\u0C80-\u0CFF]/g, '').trim();
    }

    function findBreakIndex(shlokaText, padacchedaWords) {
      if (!shlokaText || !padacchedaWords || !padacchedaWords.length) return -1;

      const parts = shlokaText.split('।');
      if (parts.length <= 1) return -1;

      const line2Words = parts[1].replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(w => w.length > 0);
      if (!line2Words.length) return -1;

      const targetWord = cleanWord(line2Words[0]);
      if (!targetWord) return -1;

      for (let idx = 0; idx < padacchedaWords.length; idx++) {
        const padWord = cleanWord(padacchedaWords[idx]);
        if (padWord && (padWord.includes(targetWord) || targetWord.includes(padWord))) {
          return idx;
        }
      }
      return -1;
    }

    function parseMeaningString(meaningString) {
      const meaningMap = {};
      if (!meaningString) return meaningMap;
      const regex = /⟣\s*([^=]+)=\s*(.+)/g;
      let match;
      while ((match = regex.exec(meaningString)) !== null) {
        meaningMap[match[1].trim()] = match[2].trim();
      }
      return meaningMap;
    }

    function buildSequentialArthaSentence(meaningString) {
      if (!meaningString) return '';
      const meaningsList = [];
      const regex = /⟣\s*([^=]+)=\s*(.+)/g;
      let match;
      while ((match = regex.exec(meaningString)) !== null) {
        const meaning = match[2].trim();
        if (meaning) meaningsList.push(meaning);
      }
      return meaningsList.join(' ');
    }

    function parseGrammarAndSandhi(grammarString) {
      const grammarMap = {};
      const sandhiMap = {};
      if (!grammarString) return { grammarMap, sandhiMap };

      const regex = /⬩\s*''([^'']+)''\s*=\s*([\s\S]*?)(?=(⬩\s*''|$))/g;
      let match;

      while ((match = regex.exec(grammarString)) !== null) {
        const wordKey = match[1].trim();
        let fullText = match[2].trim();
        const sandhiIndex = fullText.search(/\n\s*\}/);

        if (sandhiIndex !== -1) {
          grammarMap[wordKey] = fullText.substring(0, sandhiIndex).trim();
          sandhiMap[wordKey] = fullText.substring(sandhiIndex).replace(/\n\s*\}/, '').trim();
        } else {
          grammarMap[wordKey] = fullText;
        }
      }
      return { grammarMap, sandhiMap };
    }

    function renderViewer() {
      const container = document.getElementById('shloka-container');
      const padacchedaWords = parsePadaccheda(currentItem['kp_पदच्छछेदः']);
      const { sandhiMap } = parseGrammarAndSandhi(currentItem['kp_व्याकर्ण_विशेषः']);
      const fullMeaningSentence = buildSequentialArthaSentence(currentItem['kp_अर्थः']);
      
      const breakIndex = findBreakIndex(currentItem.text, padacchedaWords);

      let padacchedaHtml = '';
      let i = 0;

      while (i < padacchedaWords.length) {
        if (i === breakIndex && breakIndex > 0) {
          padacchedaHtml += `<span class="danda-mark">।</span><div class="padaccheda-line-break"></div>`;
        }

        const word = padacchedaWords[i];
        const hasSandhiWithNext = (sandhiMap[word] && i < padacchedaWords.length - 1);

        if (hasSandhiWithNext) {
          let chainHtml = '';
          while (i < padacchedaWords.length) {
            if (i === breakIndex && breakIndex > 0 && chainHtml !== '') break;

            const currentWord = padacchedaWords[i];
            const hasBridge = (sandhiMap[currentWord] && i < padacchedaWords.length - 1);

            chainHtml += `
              <div class="word-wrapper">
                <span class="word-chip" onclick="showWordGrammar('${currentWord}', event)">
                  ${currentWord}
                </span>
                ${hasBridge ? `
                  <div class="sandhi-bridge" title="Sandhi Detail" onclick="showSandhiDetails('${currentWord}', event)">
                    <div class="sandhi-node">⚡</div>
                  </div>
                ` : ''}
              </div>
            `;
            i++;
            if (!hasBridge) break;
          }
          padacchedaHtml += `<div class="sandhi-pair-container">${chainHtml}</div>`;
        } else {
          padacchedaHtml += `
            <div class="word-wrapper">
              <span class="word-chip" onclick="showWordGrammar('${word}', event)">
                ${word}
              </span>
            </div>
          `;
          i++;
        }
      }

      if (padacchedaHtml) {
        padacchedaHtml += `<span class="danda-mark">॥</span>`;
      }

      container.innerHTML = `
        <div class="verse-card">
          <div class="verse-header">
            <div>${currentItem.text || currentItem.title}</div>
          </div>
          <div class="verse-details">
            ${padacchedaHtml ? `<div class="section-title">पदच्छेदः</div><div class="padaccheda-list">${padacchedaHtml}</div>` : ''}
            
            ${currentItem['kp_अन्वयः'] ? `
              <details class="disclosure-block" open>
                <summary>अन्वयः</summary>
                <div class="disclosure-content">${currentItem['kp_अन्वयः']}</div>
              </details>
            ` : ''}

            ${fullMeaningSentence ? `
              <details class="disclosure-block" open>
                <summary>अर्थः (ಸಾರಾಂಶಃ)</summary>
                <div class="disclosure-content">${fullMeaningSentence}</div>
              </details>
            ` : ''}

            ${currentItem['kp_तात्पर्यम्'] ? `
              <details class="disclosure-block" open>
                <summary>तात्पर्यम्</summary>
                <div class="disclosure-content">${currentItem['kp_तात्पर्यम्']}</div>
              </details>
            ` : ''}
          </div>
        </div>
      `;
    }

    function showWordGrammar(word, event) {
      event.stopPropagation();
      const { grammarMap, sandhiMap } = parseGrammarAndSandhi(currentItem['kp_व्याकर्ण_विशेषः']);
      const wordMeaningMap = parseMeaningString(currentItem['kp_अर्थः']);
      
      const sidebar = document.getElementById('sidebar');
      const sidebarBody = document.getElementById('sidebar-body');

      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
      event.currentTarget.classList.add('active');

      const rawText = grammarMap[word] || 'No grammar details available for this word.';
      const kannadaMeaning = wordMeaningMap[word] || '';

      const formattedGrammar = rawText
        .split('\n')
        .map(line => `<div class="meaning-line">${line.trim()}</div>`)
        .join('');

      let sandhiHtml = '';
      if (sandhiMap[word]) {
        sandhiHtml = `<div class="sandhi-block"><strong>सन्धि-नियमः:</strong> ${sandhiMap[word]}</div>`;
      }

      document.getElementById('sidebar-title').innerText = 'व्याकरणविशेषः';
      sidebarBody.innerHTML = `
        <h2 style="margin-top:0; margin-bottom: 0.5rem; color: var(--primary-color);">${word}</h2>
        ${kannadaMeaning ? `<div class="word-meaning-subtext">${kannadaMeaning}</div>` : ''}
        <div>${formattedGrammar}</div>
        ${sandhiHtml}
      `;

      sidebar.classList.add('open');
    }

    function showSandhiDetails(word, event) {
      event.stopPropagation();
      const { sandhiMap } = parseGrammarAndSandhi(currentItem['kp_व्याकर्ण_विशेषः']);
      const sidebar = document.getElementById('sidebar');
      const sidebarBody = document.getElementById('sidebar-body');

      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
      event.currentTarget.classList.add('active');

      document.getElementById('sidebar-title').innerText = 'सन्धि-नियमः';
      sidebarBody.innerHTML = `
        <h2 style="margin-top:0; color: var(--primary-color);">सन्धिः (${word})</h2>
        <div class="sandhi-block">${sandhiMap[word]}</div>
      `;

      sidebar.classList.add('open');
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.querySelectorAll('.word-chip, .sandhi-bridge').forEach(el => el.classList.remove('active'));
    }

    renderViewer();
  </script>
</body>
</html>
\end

<$let
  c_title={{{ [<currentTiddler>encodeuricomponent[]] }}}
  c_text={{{ [<currentTiddler>get[text]encodeuricomponent[]] }}}
  c_pada={{{ [<currentTiddler>get[kp_पदच्छछेदः]encodeuricomponent[]] }}}
  c_anvaya={{{ [<currentTiddler>get[kp_अन्वयः]encodeuricomponent[]] }}}
  c_artha={{{ [<currentTiddler>get[kp_अर्थः]encodeuricomponent[]] }}}
  c_vyakarana={{{ [<currentTiddler>get[kp_व्याकर्ण_विशेषः]encodeuricomponent[]] }}}
  c_tatparya={{{ [<currentTiddler>get[kp_तात्पर्यम्]encodeuricomponent[]] }}}
>
<iframe class="shloka-viewer-frame" style="width:100%; height:82vh; border:1px solid #4c4c4c; border-radius:8px; background:#252716;" srcdoc=<<get-shloka-viewer-html title:"$(c_title)$" text:"$(c_text)$" pada:"$(c_pada)$" anvaya:"$(c_anvaya)$" artha:"$(c_artha)$" vyakarana:"$(c_vyakarana)$" tatparya:"$(c_tatparya)$">> ></iframe>
</$let>